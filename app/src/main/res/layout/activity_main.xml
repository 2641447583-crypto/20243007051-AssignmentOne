<?xml version="1.0" encoding="utf-8"?>
<!--
    Main activity layout - portrait (Part B).
    Responsive: all sizing is done with layout_weight, no hard-coded dp widths/heights.
    The only fixed text size is the banner welcome text at 40sp, as permitted.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== Top banner with welcome text overlaid ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/welcome_text"
            android:textColor="@android:color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- ===== Bottom 2x2 grid of four service buttons ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical">

        <!-- Row 1 : Facilities + Events -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Facilities -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/btn_selector"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btnFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/img_btn_facilities"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/btn_facilities"
                    android:onClick="onFacilitiesClicked" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/btn_facilities"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Events -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/btn_selector"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btnEvents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/img_btn_events"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/btn_events"
                    android:onClick="onEventsClicked" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/btn_events"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 : Clubs + Support -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Clubs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/btn_selector"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btnClubs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/img_btn_clubs"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/btn_clubs"
                    android:onClick="onClubsClicked" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/btn_clubs"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Support -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/btn_selector"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btnSupport"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/img_btn_support"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/btn_support"
                    android:onClick="onSupportClicked" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/btn_support"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
