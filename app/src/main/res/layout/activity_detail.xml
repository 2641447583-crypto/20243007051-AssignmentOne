<?xml version="1.0" encoding="utf-8"?>
<!--
    Detail activity layout (Part F).
    Top bar: small icon + large white header title (e.g. "Facilities").
    Body:    scrollable light-pink panel with a subtitle and the long content text.
    Responsive: weights used instead of hard-coded sizes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF0F5">

    <!-- ===== Green title bar with icon + header text ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/green"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/detailIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/detailHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:text="@string/detail_title_placeholder" />
    </LinearLayout>

    <!-- ===== Scrollable content panel ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFF0F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailBodyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingBottom="8dp"
                android:text="@string/detail_title_placeholder" />

            <TextView
                android:id="@+id/detailBodyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:text="@string/detail_content_placeholder" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
