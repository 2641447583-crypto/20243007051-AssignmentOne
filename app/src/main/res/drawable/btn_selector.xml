<?xml version="1.0" encoding="utf-8"?>
<!--
    Button background selector (Part C):
    - not pressed  -> green (#1B5E20)
    - pressed      -> light green (#66BB6A)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/light_green" />
    <item android:drawable="@color/green" />
</selector>
